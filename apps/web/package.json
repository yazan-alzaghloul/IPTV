    "format:check": "prettier --check src tests *.ts *.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "react-hook-form": "7.92.0",
    "@hookform/resolvers": "7.0.6",
    "zod": "4.6.7",
    "lucide-react": "1.72.0",
    "motion": "14.14.0",
    "hls.js": "1.7.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@rayan/shared-types": "workspace:*",
