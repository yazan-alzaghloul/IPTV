    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "31.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@axe-core/playwright": "4.14.0",
    "@rayan/eslint-config": "workspace:*",
    "prettier": "3.10.1"
