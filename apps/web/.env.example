# Required on every production instance. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Public deployment origin; keep staging and production separate.
APP_ORIGIN=http://localhost:3000
# Exact approved origins (scheme + host + port), comma separated. No wildcard.
PROVIDER_ORIGINS=https://your-provider.example
# Add trusted artwork/stream CDN origins here; the provider origin is already approved.
MEDIA_ORIGINS=
# Development only; ignored in production. Never enable for public deployments.
ALLOW_PRIVATE_PROVIDERS=false
# Only enable behind an ingress that OVERWRITES x-forwarded-for.
TRUST_PROXY=false
