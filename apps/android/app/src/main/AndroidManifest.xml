    <uses-feature android:name="android.software.leanback" android:required="false" />
    <queries><intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent></queries>
    <application android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="@string/app_name" android:icon="@drawable/ic_iptv" android:banner="@drawable/tv_banner" android:theme="@style/AppTheme" android:usesCleartextTraffic="true" android:supportsRtl="true" android:localeConfig="@xml/locales_config">
        <activity android:name=".PlayerActivity" android:exported="false" android:supportsPictureInPicture="true" android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout" />
