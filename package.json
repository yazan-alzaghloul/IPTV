{
  "name": "rayan-tv",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev:web": "pnpm --filter @rayan/web dev",
    "build:web": "pnpm --filter @rayan/web build",
    "check:web": "pnpm --filter @rayan/web typecheck && pnpm --filter @rayan/web lint && pnpm --filter @rayan/web test",
    "test:web:e2e": "pnpm --filter @rayan/web test:e2e"
  }
}
